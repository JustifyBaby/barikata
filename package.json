{
  "name": "barikata",
  "description": "A simple TypeScript library for validating and parsing data using Zod.",
  "version": "0.1.0",
  "author": "Justify Baby",
  "repository": {
    "type": "git",
    "url": "https://github.com/JustifyBaby/barikata.git"
  },
  "license": "MIT",
  "scripts": {
    "build:js": "bun build ./src/index.ts --outdir ./dist",
    "build:types": "bunx tsc",
    "build": "bun run build:js && bun run build:types"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "happy-dom": "^20.10.6",
    "vitest": "^4.1.9"
  },
  "module": "dist/index.js",
  "main": "dist/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "type": "module"
}
